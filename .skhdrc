# Dane's hotkeys
# open terminal
alt + shift - u : open /Applications/Ghostty.app
# open browser
alt + shift - i : open "/Applications/Brave Browser.app"
# open slack
alt + shift - p : open /Applications/Slack.app
# open obsidian
alt + shift - o : open /Applications/Obsidian.app
# open email client
alt + shift - m : open "/Applications/Proton Mail.app"

